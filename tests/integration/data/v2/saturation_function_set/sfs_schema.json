{
    "$defs": {
        "CapillaryPressureFunction": {
            "additionalProperties": false,
            "properties": {
                "FunctionUsageTypeID": {
                    "description": "Identifies the type of usage for which the function is designed (such as imbibition, drainage, etc).",
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-SaturationFunctionUsageType:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "title": "Function Usage Type ID",
                    "type": "string"
                },
                "PhaseCapillaryPressureFunctions": {
                    "description": "Set of capillary pressure functions of fluid phases present in the reservoir as a function of a saturation.",
                    "items": {
                        "$ref": "#/$defs/PhaseCapillaryPressureFunction"
                    },
                    "title": "Phase Capillary Pressure Functions",
                    "type": "array"
                }
            },
            "required": [
                "FunctionUsageTypeID",
                "PhaseCapillaryPressureFunctions"
            ],
            "title": "CapillaryPressureFunction",
            "type": "object"
        },
        "Meta": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "Unit",
                    "default": "Unit",
                    "description": "The kind of reference, 'Unit' for FrameOfReferenceUOM.",
                    "title": "UOM Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The unit symbol or name of the unit.",
                    "example": "ft[US]",
                    "title": "UOM Unit Symbol"
                },
                "persistableReference": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The self-contained, persistable reference string uniquely identifying the Unit.",
                    "example": "{\"abcd\":{\"a\":0.0,\"b\":1200.0,\"c\":3937.0,\"d\":0.0},\"symbol\":\"ft[US]\",\"baseMeasurement\":{\"ancestry\":\"L\",\"type\":\"UM\"},\"type\":\"UAD\"}",
                    "title": "UOM Persistable Reference"
                },
                "unitOfMeasureID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-UnitOfMeasure:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to unit of measure reference.",
                    "example": "namespace:reference-data--UnitOfMeasure:ftUS:",
                    "title": "Unitofmeasureid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides Unit context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "HorizontalDeflection.EastWest",
                        "HorizontalDeflection.NorthSouth"
                    ],
                    "title": "UOM Property Names"
                }
            },
            "title": "Meta",
            "type": "object"
        },
        "Meta1": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "CRS",
                    "default": "CRS",
                    "description": "The kind of reference, constant 'CRS' for FrameOfReferenceCRS.",
                    "title": "CRS Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS.",
                    "example": "WGS 84 / UTM zone 15N",
                    "title": "CRS Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying the CRS.",
                    "example": "{\"authCode\":{\"auth\":\"EPSG\",\"code\":\"32615\"},\"name\":\"WGS_1984_UTM_Zone_15N\",\"type\":\"LBC\",\"ver\":\"PE_10_9_1\",\"wkt\":\"PROJCS[\\\"WGS_1984_UTM_Zone_15N\\\",GEOGCS[\\\"GCS_WGS_1984\\\",DATUM[\\\"D_WGS_1984\\\",SPHEROID[\\\"WGS_1984\\\",6378137.0,298.257223563]],PRIMEM[\\\"Greenwich\\\",0.0],UNIT[\\\"Degree\\\",0.0174532925199433]],PROJECTION[\\\"Transverse_Mercator\\\"],PARAMETER[\\\"False_Easting\\\",500000.0],PARAMETER[\\\"False_Northing\\\",0.0],PARAMETER[\\\"Central_Meridian\\\",-93.0],PARAMETER[\\\"Scale_Factor\\\",0.9996],PARAMETER[\\\"Latitude_Of_Origin\\\",0.0],UNIT[\\\"Meter\\\",1.0],AUTHORITY[\\\"EPSG\\\",32615]]\"}",
                    "title": "CRS Persistable Reference",
                    "type": "string"
                },
                "coordinateReferenceSystemID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-CoordinateReferenceSystem:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to CRS reference.",
                    "example": "namespace:reference-data--CoordinateReferenceSystem:Projected:EPSG::32615:",
                    "title": "Coordinatereferencesystemid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides CRS context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "KickOffPosition.X",
                        "KickOffPosition.Y"
                    ],
                    "title": "CRS Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta1",
            "type": "object"
        },
        "Meta2": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "DateTime",
                    "default": "DateTime",
                    "description": "The kind of reference, constant 'DateTime', for FrameOfReferenceDateTime.",
                    "title": "DateTime Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the DateTime format and reference.",
                    "example": "UTC",
                    "title": "DateTime Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying DateTime reference.",
                    "example": "{\"format\":\"yyyy-MM-ddTHH:mm:ssZ\",\"timeZone\":\"UTC\",\"type\":\"DTM\"}",
                    "title": "DateTime Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides DateTime context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Acquisition.StartTime",
                        "Acquisition.EndTime"
                    ],
                    "title": "DateTime Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta2",
            "type": "object"
        },
        "Meta3": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "AzimuthReference",
                    "default": "AzimuthReference",
                    "description": "The kind of reference, constant 'AzimuthReference', for FrameOfReferenceAzimuthReference.",
                    "title": "AzimuthReference Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS or the symbol/name of the unit.",
                    "example": "TrueNorth",
                    "title": "AzimuthReference Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying AzimuthReference.",
                    "example": "{\"code\":\"TrueNorth\",\"type\":\"AZR\"}",
                    "title": "AzimuthReference Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides AzimuthReference context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Bearing"
                    ],
                    "title": "AzimuthReference Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta3",
            "type": "object"
        },
        "PhaseCapillaryPressureFunction": {
            "additionalProperties": false,
            "properties": {
                "Saturation": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Saturation values for which the capillary pressures are tabulated.",
                    "title": "Saturation"
                },
                "CapillaryPressure": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Capillary Pressure values of the fluid phase at the corresponding saturation values.",
                    "title": "Capillary Pressure"
                },
                "PhaseCapillaryPressureFluidID": {
                    "description": "Identifies the fluid phase that refers to the capillary pressure.",
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-RockModelCapillaryPressurePhase:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "title": "Phase Capillary Pressure Fluid ID",
                    "type": "string"
                },
                "PhaseSaturationFluidID": {
                    "description": "Identifies the fluid phase that is being used for the saturation.",
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-FluidModelPropertyPhase:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "title": "Phase Saturation Fluid ID",
                    "type": "string"
                }
            },
            "required": [
                "PhaseCapillaryPressureFluidID",
                "PhaseSaturationFluidID"
            ],
            "title": "PhaseCapillaryPressureFunction",
            "type": "object"
        },
        "PhaseRelativePermeabilityFunction": {
            "additionalProperties": false,
            "properties": {
                "Saturation": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Saturation values for which the relative permeabilities are tabulated.",
                    "title": "Saturation"
                },
                "RelativePermeability": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Relative permeability values of the fluid phase at the corresponding saturation values. ",
                    "title": "Relative Permeability"
                },
                "PhaseRelativePermeabilityFluidID": {
                    "description": "Identifies the fluid phase that the relative permeability characterizes.",
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-RockModelRelativePermeabilityPhase:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "title": "Phase Relative Permeability Fluid ID",
                    "type": "string"
                },
                "PhaseSaturationFluidID": {
                    "description": "Identifies the fluid phase that is being used for the saturation.",
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-FluidModelPropertyPhase:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "title": "Phase Saturation Fluid ID",
                    "type": "string"
                }
            },
            "required": [
                "PhaseRelativePermeabilityFluidID",
                "PhaseSaturationFluidID"
            ],
            "title": "PhaseRelativePermeabilityFunction",
            "type": "object"
        },
        "RelativePermeabilityFunction": {
            "additionalProperties": false,
            "properties": {
                "FunctionUsageTypeID": {
                    "description": "Identifies the type of usage for which the function is designed (such as imbibition, drainage, etc)",
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-SaturationFunctionUsageType:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "title": "Function Usage Type ID",
                    "type": "string"
                },
                "PhaseRelativePermeabilityFunctions": {
                    "description": "Set of relative permeability functions of fluid phases present in the reservoir as a function of a saturation.",
                    "items": {
                        "$ref": "#/$defs/PhaseRelativePermeabilityFunction"
                    },
                    "title": "Phase Relative Permeability Functions",
                    "type": "array"
                }
            },
            "required": [
                "FunctionUsageTypeID",
                "PhaseRelativePermeabilityFunctions"
            ],
            "title": "RelativePermeabilityFunction",
            "type": "object"
        }
    },
    "additionalProperties": false,
    "properties": {
        "SaturationFunctionSetID": {
            "description": "A reference back to the work product component SaturationFunctionSet record, to which the content belongs.",
            "pattern": "^[\\w\\-\\.]+:work-product-component\\-\\-SaturationFunctionSet:[\\w\\-\\.\\:\\%]+:[0-9]*$",
            "title": "Saturation Function Set ID",
            "type": "string"
        },
        "Meta": {
            "anyOf": [
                {
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/Meta"
                            },
                            {
                                "$ref": "#/$defs/Meta1"
                            },
                            {
                                "$ref": "#/$defs/Meta2"
                            },
                            {
                                "$ref": "#/$defs/Meta3"
                            }
                        ]
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A meta data item, which allows the association of named properties or property values to a Unit/Measurement/CRS/Azimuth/Time context.",
            "title": "Meta"
        },
        "RelativePermeabilityFunctions": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/RelativePermeabilityFunction"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Set of relative permeability values as a function of saturation in two-, or three-phase systems for drainage and/or imbibition processes.",
            "title": "Relative Permeability Functions"
        },
        "CapillaryPressureFunctions": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/CapillaryPressureFunction"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Set of capillary pressure values as function of saturation in two-, or three-phase systems for drainage and/or imbibition processes.",
            "title": "Capillary Pressure Functions"
        }
    },
    "required": [
        "SaturationFunctionSetID"
    ],
    "title": "SaturationFunctionSetModel100",
    "type": "object"
}
