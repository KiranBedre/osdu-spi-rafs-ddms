{
    "$defs": {
        "Compressibility": {
            "additionalProperties": false,
            "properties": {
                "ReferencePressure": {
                    "description": "The reference pressure applicable to your compressibility value.",
                    "title": "Reference Pressure",
                    "type": "number"
                },
                "PoreVolumeCompressibilityAtReferencePressure": {
                    "description": "Pore volume compressibility at the reference pressure.",
                    "title": "Pore Volume Compressibility",
                    "type": "number"
                }
            },
            "required": [
                "ReferencePressure",
                "PoreVolumeCompressibilityAtReferencePressure"
            ],
            "title": "Compressibility",
            "type": "object"
        },
        "Compressibility1": {
            "additionalProperties": false,
            "properties": {
                "Pressure": {
                    "description": "Table of pressure values.",
                    "items": {
                        "type": "number"
                    },
                    "title": "Pressure",
                    "type": "array"
                },
                "PoreVolumeCompressibility": {
                    "description": "Pore volume compressibility values corresponding to the pressure values.",
                    "items": {
                        "type": "number"
                    },
                    "title": "Pore Volume Compressibility",
                    "type": "array"
                },
                "TransmissibilityCompressibility": {
                    "description": "The corresponding transmissibility compressibility values applied to transmissibility during compaction.  The X direction transmissibility compressibility values applied to transmissibility during compaction. If no other directional values are populated, X is the default.",
                    "items": {
                        "type": "number"
                    },
                    "title": "Transmissibility Compressibility",
                    "type": "array"
                },
                "Y-DirectionTransmissibilityCompressibility": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The Y direction transmissibility compressibility values applied to transmissibility during compaction.",
                    "title": "Y-Direction Transmissibility Compressibility"
                },
                "Z-DirectionTransmissibilityCompressibility": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The Z direction transmissibility compressibility values applied to transmissibility during compaction.",
                    "title": "Z-Direction Transmissibility Compressibility"
                },
                "ReferencePressure": {
                    "description": "Reference pressure at which the initial compaction adjustment to the pore volume is performed.",
                    "title": "Reference Pressure",
                    "type": "number"
                }
            },
            "required": [
                "Pressure",
                "PoreVolumeCompressibility",
                "TransmissibilityCompressibility",
                "ReferencePressure"
            ],
            "title": "Compressibility1",
            "type": "object"
        },
        "Compressibility2": {
            "additionalProperties": false,
            "properties": {
                "Pressure": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Table of pressure values.",
                    "title": "Pressure"
                },
                "PoreVolumeMultiplier": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The pore volume multipliers corresponding to the pressure values.",
                    "title": "Pore Volume Multiplier"
                },
                "TransmissibilityMultiplier": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The transmissibility multipliers corresponding to the pressure values.",
                    "title": "Transmissibility Multiplier"
                }
            },
            "title": "Compressibility2",
            "type": "object"
        },
        "Meta": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "Unit",
                    "default": "Unit",
                    "description": "The kind of reference, 'Unit' for FrameOfReferenceUOM.",
                    "title": "UOM Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The unit symbol or name of the unit.",
                    "example": "ft[US]",
                    "title": "UOM Unit Symbol"
                },
                "persistableReference": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The self-contained, persistable reference string uniquely identifying the Unit.",
                    "example": "{\"abcd\":{\"a\":0.0,\"b\":1200.0,\"c\":3937.0,\"d\":0.0},\"symbol\":\"ft[US]\",\"baseMeasurement\":{\"ancestry\":\"L\",\"type\":\"UM\"},\"type\":\"UAD\"}",
                    "title": "UOM Persistable Reference"
                },
                "unitOfMeasureID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-UnitOfMeasure:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to unit of measure reference.",
                    "example": "namespace:reference-data--UnitOfMeasure:ftUS:",
                    "title": "Unitofmeasureid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides Unit context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "HorizontalDeflection.EastWest",
                        "HorizontalDeflection.NorthSouth"
                    ],
                    "title": "UOM Property Names"
                }
            },
            "title": "Meta",
            "type": "object"
        },
        "Meta1": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "CRS",
                    "default": "CRS",
                    "description": "The kind of reference, constant 'CRS' for FrameOfReferenceCRS.",
                    "title": "CRS Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS.",
                    "example": "WGS 84 / UTM zone 15N",
                    "title": "CRS Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying the CRS.",
                    "example": "{\"authCode\":{\"auth\":\"EPSG\",\"code\":\"32615\"},\"name\":\"WGS_1984_UTM_Zone_15N\",\"type\":\"LBC\",\"ver\":\"PE_10_9_1\",\"wkt\":\"PROJCS[\\\"WGS_1984_UTM_Zone_15N\\\",GEOGCS[\\\"GCS_WGS_1984\\\",DATUM[\\\"D_WGS_1984\\\",SPHEROID[\\\"WGS_1984\\\",6378137.0,298.257223563]],PRIMEM[\\\"Greenwich\\\",0.0],UNIT[\\\"Degree\\\",0.0174532925199433]],PROJECTION[\\\"Transverse_Mercator\\\"],PARAMETER[\\\"False_Easting\\\",500000.0],PARAMETER[\\\"False_Northing\\\",0.0],PARAMETER[\\\"Central_Meridian\\\",-93.0],PARAMETER[\\\"Scale_Factor\\\",0.9996],PARAMETER[\\\"Latitude_Of_Origin\\\",0.0],UNIT[\\\"Meter\\\",1.0],AUTHORITY[\\\"EPSG\\\",32615]]\"}",
                    "title": "CRS Persistable Reference",
                    "type": "string"
                },
                "coordinateReferenceSystemID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-CoordinateReferenceSystem:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to CRS reference.",
                    "example": "namespace:reference-data--CoordinateReferenceSystem:Projected:EPSG::32615:",
                    "title": "Coordinatereferencesystemid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides CRS context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "KickOffPosition.X",
                        "KickOffPosition.Y"
                    ],
                    "title": "CRS Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta1",
            "type": "object"
        },
        "Meta2": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "DateTime",
                    "default": "DateTime",
                    "description": "The kind of reference, constant 'DateTime', for FrameOfReferenceDateTime.",
                    "title": "DateTime Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the DateTime format and reference.",
                    "example": "UTC",
                    "title": "DateTime Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying DateTime reference.",
                    "example": "{\"format\":\"yyyy-MM-ddTHH:mm:ssZ\",\"timeZone\":\"UTC\",\"type\":\"DTM\"}",
                    "title": "DateTime Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides DateTime context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Acquisition.StartTime",
                        "Acquisition.EndTime"
                    ],
                    "title": "DateTime Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta2",
            "type": "object"
        },
        "Meta3": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "AzimuthReference",
                    "default": "AzimuthReference",
                    "description": "The kind of reference, constant 'AzimuthReference', for FrameOfReferenceAzimuthReference.",
                    "title": "AzimuthReference Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS or the symbol/name of the unit.",
                    "example": "TrueNorth",
                    "title": "AzimuthReference Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying AzimuthReference.",
                    "example": "{\"code\":\"TrueNorth\",\"type\":\"AZR\"}",
                    "title": "AzimuthReference Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides AzimuthReference context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Bearing"
                    ],
                    "title": "AzimuthReference Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta3",
            "type": "object"
        },
        "ThermalModelDefinition": {
            "additionalProperties": false,
            "properties": {
                "ThermalConductivity": {
                    "description": "Thermal conductivity of rock and fluids.",
                    "title": "Thermal Conductivity",
                    "type": "number"
                },
                "HeatCapacity": {
                    "description": "Rock heat capacity.",
                    "title": "Heat Capacity",
                    "type": "number"
                }
            },
            "required": [
                "ThermalConductivity",
                "HeatCapacity"
            ],
            "title": "ThermalModelDefinition",
            "type": "object"
        }
    },
    "additionalProperties": false,
    "properties": {
        "ReservoirSimulationRockPhysicsID": {
            "description": "A reference back to the Reservoir Simulation Rock Physics record, to which the content belongs.",
            "example": "namespace:work-product-component--ReservoirSimulationRockPhysicsModel:uuid:",
            "pattern": "^[\\w\\-\\.]+:work-product-component\\-\\-ReservoirSimulationRockPhysicsModel:[\\w\\-\\.\\:\\%]+:[0-9]*$",
            "title": "Reservoir Simulation Rock Physics ID",
            "type": "string"
        },
        "Meta": {
            "anyOf": [
                {
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/Meta"
                            },
                            {
                                "$ref": "#/$defs/Meta1"
                            },
                            {
                                "$ref": "#/$defs/Meta2"
                            },
                            {
                                "$ref": "#/$defs/Meta3"
                            }
                        ]
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A meta data item, which allows the association of named properties or property values to a Unit/Measurement/CRS/Azimuth/Time context.",
            "title": "Meta"
        },
        "Compressibility": {
            "anyOf": [
                {
                    "$ref": "#/$defs/Compressibility"
                },
                {
                    "$ref": "#/$defs/Compressibility1"
                },
                {
                    "$ref": "#/$defs/Compressibility2"
                }
            ],
            "description": "Pore/bulk compressibility is a relative change of a pore/bulk volume of a rock in response to a unit change in pressure.",
            "title": "Compressibility"
        },
        "ThermalModelDefinition": {
            "anyOf": [
                {
                    "$ref": "#/$defs/ThermalModelDefinition"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A mathematical model which accounts for physical, chemical, and thermal behavior of multi-phase fluid flow in reservoirs.",
            "title": "Thermal Model Definition"
        }
    },
    "required": [
        "ReservoirSimulationRockPhysicsID",
        "Compressibility"
    ],
    "title": "ReservoirSimulationRockPhysicsModelModel100",
    "type": "object"
}
