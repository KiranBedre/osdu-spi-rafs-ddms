{
    "$defs": {
        "InjectedGa": {
            "additionalProperties": false,
            "properties": {
                "ComponentNameID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-SampleOrganicCompositionComponent:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Name of the component in the injected gas.",
                    "title": "Component Name ID"
                },
                "RelativeMoleWeight": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Molar mass relative to other components.",
                    "title": "Relative Mole Weight"
                },
                "MolecularWeight": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The molecular weight of the component.",
                    "title": "Molecular Weight"
                },
                "MolePercent": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The molar percentage of the component, if available.",
                    "title": "Mole Percent"
                },
                "MassPercent": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The mass percentage of the component, if available.",
                    "title": "Mass Percent"
                },
                "VolumePercent": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The volume percentage of the component, if available.",
                    "title": "Volume Percent"
                },
                "SpecificGravity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The specific gravity of the component.",
                    "title": "Specific Gravity"
                }
            },
            "title": "InjectedGa",
            "type": "object"
        },
        "LiquidCompositionItem": {
            "additionalProperties": false,
            "properties": {
