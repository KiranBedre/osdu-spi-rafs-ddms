{
    "$defs": {
        "CrushTestDatum": {
            "additionalProperties": false,
            "properties": {
                "Fines": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Mass percentage of fines after being exposed to stress.",
                    "title": "Fines"
                },
                "Stress": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Stress measured at a point during a crush test.",
                    "title": "Stress"
                }
            },
            "title": "CrushTestDatum",
            "type": "object"
        },
        "ISO135032Property": {
            "additionalProperties": false,
            "properties": {
                "AbsoluteDensity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The density the material would have if no intra-granular porosity is present. (e.g. Boyle's Law porosimetry).",
                    "title": "Absolute Density"
                },
                "AcidSolubility": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The solubility of a proppant in 12:3 HCl:HF for 30 minutes at 150\u00b0F is an indication of the amount of soluble materials (i.e. carbonates, feldspars, iron oxides, clays, etc) present in the proppant.",
                    "title": "Acid Solubility"
                },
                "ApparentDensity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Apparent density excludes extra-granular porosity by placing a known mass in a volume of fluid and determining how much of the fluid is displaced (Archimedes).",
                    "title": "Apparent Density"
                },
                "BulkDensity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Bulk density includes both the proppant and the porosity. This is measured by filling a known volume with dry proppant and measuring the weight.",
                    "title": "Bulk Density"
                },
                "ClustersPercent": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Percentage of undesirable agglomerated discrete proppant particles which typically occurs more with inefficiently processed natural sand proppants as opposed to manufactured ceramic proppants. ISO 13503-2 and API RP19C limit the mass of clusters to less than 1%.",
                    "title": "Clusters Percent"
                },
                "CrushTestData": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/CrushTestDatum"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Crush Test Data",
                    "title": "Crush Test Data"
                },
                "KValue": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Crush test classification indicating the highest stress level at which a proppant generated no more than 10% crushed material rounded down to the nearest 1,000 psi during a crush test. For example, a value of 14 means 14k which is 14000 psi.",
                    "title": "K Value"
                },
                "LossOnIgnition": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A mass loss (gravimetric) test method applied to coated proppants only, which determines the mass of resin coating applied to a natural sand or manufactured proppant by means of thorough combustion of the flammable resin from the nonflammable proppant. Reported as a % of original mass.",
                    "title": "Loss On Ignition"
                },
                "MeanParticleDiameter": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The mean diameter of particles in a sample of proppant.",
                    "title": "Mean Particle Diameter"
                },
                "MedianParticleDiameter": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The median diameter of particles in a sample of proppant.",
                    "title": "Median Particle Diameter"
                },
                "Roundness": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Krumbein Roundness Shape Factor that is a measure of the relative sharpness of grain corners or of grain curvature. Krumbein and Sloss (1963) are the most widely used method of determining shape factors.",
                    "title": "Roundness"
                },
                "SieveAnalysisData": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/SieveAnalysisDatum"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Sieve Analysis Data",
                    "title": "Sieve Analysis Data"
                },
                "SpecificGravity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Not formally part of ISO 13503.2 properties, the specific gravity is the apparent density of the proppant divided by the density of water.",
                    "title": "Specific Gravity"
                },
                "Sphericity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Krumbein Sphericity Shape Factor that is a measure of how closely a proppant particle approaches the shape of a sphere. Krumbein and Sloss (1963) are the most widely used method of determining shape factors.",
                    "title": "Sphericity"
                },
                "TurbidityNTU": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A measure of water clarity, how much the material suspended in water decreases the passage of light through the water.   Measured according to USEPA 180.1 and expressed in Nephelometric Turbidity Units (NTU).",
                    "title": "Turbidity NTU"
                },
                "TurbidityFNU": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A measure of water clarity, how much the material suspended in water decreases the passage of light through the water. Measured according to ISO 7027 and expressed in Formazin Nephelometric Units (FNU).",
                    "title": "Turbidity FNU"
                }
            },
            "title": "ISO135032Property",
            "type": "object"
        },
        "ISO135035PointItem": {
            "additionalProperties": false,
            "properties": {
                "Conductivity": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Proppant conductivity under stress.",
                    "title": "Conductivity"
                },
                "Permeability": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Proppant permeability under stress.",
                    "title": "Permeability"
                },
                "StressApplied": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The amount of stress applied.",
                    "title": "Stress Applied"
                },
                "Temperature": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The temperature at the time measurements were taken.",
                    "title": "Temperature"
                }
            },
            "title": "ISO135035PointItem",
            "type": "object"
        },
        "Meta": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "Unit",
                    "default": "Unit",
                    "description": "The kind of reference, 'Unit' for FrameOfReferenceUOM.",
                    "title": "UOM Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The unit symbol or name of the unit.",
                    "example": "ft[US]",
                    "title": "UOM Unit Symbol"
                },
                "persistableReference": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The self-contained, persistable reference string uniquely identifying the Unit.",
                    "example": "{\"abcd\":{\"a\":0.0,\"b\":1200.0,\"c\":3937.0,\"d\":0.0},\"symbol\":\"ft[US]\",\"baseMeasurement\":{\"ancestry\":\"L\",\"type\":\"UM\"},\"type\":\"UAD\"}",
                    "title": "UOM Persistable Reference"
                },
                "unitOfMeasureID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-UnitOfMeasure:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to unit of measure reference.",
                    "example": "namespace:reference-data--UnitOfMeasure:ftUS:",
                    "title": "Unitofmeasureid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides Unit context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "HorizontalDeflection.EastWest",
                        "HorizontalDeflection.NorthSouth"
                    ],
                    "title": "UOM Property Names"
                }
            },
            "title": "Meta",
            "type": "object"
        },
        "Meta1": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "CRS",
                    "default": "CRS",
                    "description": "The kind of reference, constant 'CRS' for FrameOfReferenceCRS.",
                    "title": "CRS Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS.",
                    "example": "WGS 84 / UTM zone 15N",
                    "title": "CRS Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying the CRS.",
                    "example": "{\"authCode\":{\"auth\":\"EPSG\",\"code\":\"32615\"},\"name\":\"WGS_1984_UTM_Zone_15N\",\"type\":\"LBC\",\"ver\":\"PE_10_9_1\",\"wkt\":\"PROJCS[\\\"WGS_1984_UTM_Zone_15N\\\",GEOGCS[\\\"GCS_WGS_1984\\\",DATUM[\\\"D_WGS_1984\\\",SPHEROID[\\\"WGS_1984\\\",6378137.0,298.257223563]],PRIMEM[\\\"Greenwich\\\",0.0],UNIT[\\\"Degree\\\",0.0174532925199433]],PROJECTION[\\\"Transverse_Mercator\\\"],PARAMETER[\\\"False_Easting\\\",500000.0],PARAMETER[\\\"False_Northing\\\",0.0],PARAMETER[\\\"Central_Meridian\\\",-93.0],PARAMETER[\\\"Scale_Factor\\\",0.9996],PARAMETER[\\\"Latitude_Of_Origin\\\",0.0],UNIT[\\\"Meter\\\",1.0],AUTHORITY[\\\"EPSG\\\",32615]]\"}",
                    "title": "CRS Persistable Reference",
                    "type": "string"
                },
                "coordinateReferenceSystemID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-CoordinateReferenceSystem:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to CRS reference.",
                    "example": "namespace:reference-data--CoordinateReferenceSystem:Projected:EPSG::32615:",
                    "title": "Coordinatereferencesystemid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides CRS context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "KickOffPosition.X",
                        "KickOffPosition.Y"
                    ],
                    "title": "CRS Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta1",
            "type": "object"
        },
        "Meta2": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "DateTime",
                    "default": "DateTime",
                    "description": "The kind of reference, constant 'DateTime', for FrameOfReferenceDateTime.",
                    "title": "DateTime Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the DateTime format and reference.",
                    "example": "UTC",
                    "title": "DateTime Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying DateTime reference.",
                    "example": "{\"format\":\"yyyy-MM-ddTHH:mm:ssZ\",\"timeZone\":\"UTC\",\"type\":\"DTM\"}",
                    "title": "DateTime Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides DateTime context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Acquisition.StartTime",
                        "Acquisition.EndTime"
                    ],
                    "title": "DateTime Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta2",
            "type": "object"
        },
        "Meta3": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "AzimuthReference",
                    "default": "AzimuthReference",
                    "description": "The kind of reference, constant 'AzimuthReference', for FrameOfReferenceAzimuthReference.",
                    "title": "AzimuthReference Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS or the symbol/name of the unit.",
                    "example": "TrueNorth",
                    "title": "AzimuthReference Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying AzimuthReference.",
                    "example": "{\"code\":\"TrueNorth\",\"type\":\"AZR\"}",
                    "title": "AzimuthReference Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides AzimuthReference context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Bearing"
                    ],
                    "title": "AzimuthReference Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta3",
            "type": "object"
        },
        "ProppantAgent": {
            "additionalProperties": false,
            "properties": {
                "ProppantName": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the proppant.",
                    "example": "70 Ottawa Sand",
                    "title": "Proppant Name"
                },
                "FrictionCoefficientLaminar": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Laminar flow friction coefficient.",
                    "title": "Friction Coefficient Laminar"
                },
                "FrictionCoefficientTurbulent": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Turbulent flow friction coefficient.",
                    "title": "Friction Coefficient Turbulent"
                },
                "MassAbsorptionCoefficient": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Characterizes how easily radiation passes through a material. This can be used to compute the concentration of proppant in a slurry using a densitometer.",
                    "title": "Mass Absorption Coefficient"
                },
                "MeshSizeHigh": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Integer high value of sieve mesh size: for 4070 sand, this value is 70. For a 70 sand this would be 70.",
                    "example": 70,
                    "title": "Mesh Size High"
                },
                "MeshSizeLow": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Integer low value of sieve mesh size: for 4070 sand, this value is 40.",
                    "example": 70,
                    "title": "Mesh Size Low"
                },
                "ProppantTypeID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-StimProppantAgentType:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Proppant type or function.",
                    "example": "namespace:reference-data--StimProppantAgentType:Sand:",
                    "title": "Proppant Type ID"
                },
                "UnconfinedCompressiveStrength": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The unconfined compressive strength of the proppant.",
                    "title": "Unconfined Compressive Strength"
                },
                "ISO13503_2Properties": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/ISO135032Property"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "ISO 13503_2 Properties"
                },
                "ISO13503_5Point": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/ISO135035PointItem"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "ISO 13503_5 Point"
                },
                "SupplierName": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the proppant supplier.",
                    "example": "ASTM Sands",
                    "title": "Supplier Name"
                },
                "SupplierID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:master-data\\-\\-Organisation:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Identifier of service company organisation providing this proppant agent for the stimulation job.",
                    "title": "Supplier ID"
                },
                "SupplierProductCode": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Supplier's product number/code.",
                    "example": "70OTTSAND",
                    "title": "Supplier Product Code"
                },
                "Remarks": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "General remarks about this proppant agent.",
                    "title": "Remarks"
                }
            },
            "title": "ProppantAgent",
            "type": "object"
        },
        "Remark": {
            "additionalProperties": false,
            "properties": {
                "RemarkSequenceNumber": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A unique identifier for each remark record. This identifier is used to uniquely identify a member in an array of remarks.",
                    "example": 1,
                    "title": "Remark Sequence Number"
                },
                "Remark": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A descriptive comment for this remark.",
                    "title": "Remark"
                },
                "RemarkSource": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The person, vendor, interpreter or other provider of information.",
                    "title": "Remark Source"
                },
                "RemarkDate": {
                    "anyOf": [
                        {
                            "format": "date",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The date the remark was issued.",
                    "title": "Remark Date"
                }
            },
            "title": "Remark",
            "type": "object"
        },
        "SieveAnalysisDatum": {
            "additionalProperties": false,
            "properties": {
                "PercentRetained": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The percentage of mass retained in the sieve.",
                    "title": "Percent Retained"
                },
                "SieveNumber": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "ASTM US Standard Mesh opening size used in the sieve analysis test. To indicate Pan, use 0.",
                    "title": "Sieve Number"
                }
            },
            "title": "SieveAnalysisDatum",
            "type": "object"
        },
        "TestStep": {
            "additionalProperties": false,
            "properties": {
                "StepNumber": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Internal step number which identifies the repeated steps in this analysis.",
