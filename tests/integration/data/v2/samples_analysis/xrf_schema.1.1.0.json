{
    "$defs": {
        "ElementalCompositionItem": {
            "additionalProperties": false,
            "properties": {
                "ElementID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-Elements:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The chemical element identified in the XRF analysis.",
                    "title": "Element ID"
                },
                "Content": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The quantified amount or concentration of the identified element in the sample.",
                    "title": "Content"
                }
            },
            "title": "ElementalCompositionItem",
            "type": "object"
        },
        "Meta": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "Unit",
                    "default": "Unit",
                    "description": "The kind of reference, 'Unit' for FrameOfReferenceUOM.",
                    "title": "UOM Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The unit symbol or name of the unit.",
                    "example": "ft[US]",
                    "title": "UOM Unit Symbol"
                },
                "persistableReference": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The self-contained, persistable reference string uniquely identifying the Unit.",
                    "example": "{\"abcd\":{\"a\":0.0,\"b\":1200.0,\"c\":3937.0,\"d\":0.0},\"symbol\":\"ft[US]\",\"baseMeasurement\":{\"ancestry\":\"L\",\"type\":\"UM\"},\"type\":\"UAD\"}",
                    "title": "UOM Persistable Reference"
                },
                "unitOfMeasureID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-UnitOfMeasure:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to unit of measure reference.",
                    "example": "namespace:reference-data--UnitOfMeasure:ftUS:",
                    "title": "Unitofmeasureid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides Unit context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "HorizontalDeflection.EastWest",
                        "HorizontalDeflection.NorthSouth"
                    ],
                    "title": "UOM Property Names"
                }
            },
            "title": "Meta",
            "type": "object"
        },
        "Meta1": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "CRS",
                    "default": "CRS",
                    "description": "The kind of reference, constant 'CRS' for FrameOfReferenceCRS.",
                    "title": "CRS Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS.",
                    "example": "WGS 84 / UTM zone 15N",
                    "title": "CRS Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying the CRS.",
                    "example": "{\"authCode\":{\"auth\":\"EPSG\",\"code\":\"32615\"},\"name\":\"WGS_1984_UTM_Zone_15N\",\"type\":\"LBC\",\"ver\":\"PE_10_9_1\",\"wkt\":\"PROJCS[\\\"WGS_1984_UTM_Zone_15N\\\",GEOGCS[\\\"GCS_WGS_1984\\\",DATUM[\\\"D_WGS_1984\\\",SPHEROID[\\\"WGS_1984\\\",6378137.0,298.257223563]],PRIMEM[\\\"Greenwich\\\",0.0],UNIT[\\\"Degree\\\",0.0174532925199433]],PROJECTION[\\\"Transverse_Mercator\\\"],PARAMETER[\\\"False_Easting\\\",500000.0],PARAMETER[\\\"False_Northing\\\",0.0],PARAMETER[\\\"Central_Meridian\\\",-93.0],PARAMETER[\\\"Scale_Factor\\\",0.9996],PARAMETER[\\\"Latitude_Of_Origin\\\",0.0],UNIT[\\\"Meter\\\",1.0],AUTHORITY[\\\"EPSG\\\",32615]]\"}",
                    "title": "CRS Persistable Reference",
                    "type": "string"
                },
                "coordinateReferenceSystemID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-CoordinateReferenceSystem:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "SRN to CRS reference.",
                    "example": "namespace:reference-data--CoordinateReferenceSystem:Projected:EPSG::32615:",
                    "title": "Coordinatereferencesystemid"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides CRS context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "KickOffPosition.X",
                        "KickOffPosition.Y"
                    ],
                    "title": "CRS Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta1",
            "type": "object"
        },
        "Meta2": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "DateTime",
                    "default": "DateTime",
                    "description": "The kind of reference, constant 'DateTime', for FrameOfReferenceDateTime.",
                    "title": "DateTime Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the DateTime format and reference.",
                    "example": "UTC",
                    "title": "DateTime Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying DateTime reference.",
                    "example": "{\"format\":\"yyyy-MM-ddTHH:mm:ssZ\",\"timeZone\":\"UTC\",\"type\":\"DTM\"}",
                    "title": "DateTime Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides DateTime context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Acquisition.StartTime",
                        "Acquisition.EndTime"
                    ],
                    "title": "DateTime Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta2",
            "type": "object"
        },
        "Meta3": {
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "const": "AzimuthReference",
                    "default": "AzimuthReference",
                    "description": "The kind of reference, constant 'AzimuthReference', for FrameOfReferenceAzimuthReference.",
                    "title": "AzimuthReference Reference Kind",
                    "type": "string"
                },
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The name of the CRS or the symbol/name of the unit.",
                    "example": "TrueNorth",
                    "title": "AzimuthReference Name"
                },
                "persistableReference": {
                    "description": "The self-contained, persistable reference string uniquely identifying AzimuthReference.",
                    "example": "{\"code\":\"TrueNorth\",\"type\":\"AZR\"}",
                    "title": "AzimuthReference Persistable Reference",
                    "type": "string"
                },
                "propertyNames": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The list of property names, to which this meta data item provides AzimuthReference context to. A full path like \"StructureA.PropertyB\" is required to define a unique context; \"data\" is omitted since frame-of reference normalization only applies to the data block.",
                    "example": [
                        "Bearing"
                    ],
                    "title": "AzimuthReference Property Names"
                }
            },
            "required": [
                "persistableReference"
            ],
            "title": "Meta3",
            "type": "object"
        },
        "OxideCompositionItem": {
            "additionalProperties": false,
            "properties": {
                "OxideID": {
                    "anyOf": [
                        {
                            "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-Oxides:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A binary compound of oxygen with another element or group of elements.",
                    "title": "Oxide ID"
                },
                "Content": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The calculated Oxide concentration based on the measured element concentrations.",
                    "title": "Content"
                }
            },
            "title": "OxideCompositionItem",
            "type": "object"
        }
    },
    "additionalProperties": false,
    "properties": {
        "SamplesAnalysisID": {
            "description": "The OSDU Identifier for this SamplesAnalysis.",
            "pattern": "^[\\w\\-\\.]+:work-product-component\\-\\-SamplesAnalysis:[\\w\\-\\.\\:\\%]+:[0-9]*$",
            "title": "Samples Analysis ID",
            "type": "string"
        },
        "SampleID": {
            "description": "The OSDU Identifier for the Sample associated with this analysis.",
            "pattern": "^[\\w\\-\\.]+:master-data\\-\\-Sample:[\\w\\-\\.\\:\\%]+:[0-9]*$",
            "title": "Sample ID",
            "type": "string"
        },
        "Meta": {
            "description": "A meta data item, which allows the association of named properties or property values to a Unit/Measurement/CRS/Azimuth/Time context.",
            "example": "",
            "items": {
                "anyOf": [
                    {
                        "$ref": "#/$defs/Meta"
                    },
                    {
                        "$ref": "#/$defs/Meta1"
                    },
                    {
                        "$ref": "#/$defs/Meta2"
                    },
                    {
                        "$ref": "#/$defs/Meta3"
                    }
                ]
            },
            "title": "Meta",
            "type": "array"
        },
        "ElementalComposition": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/ElementalCompositionItem"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The elemental composition of the sample determined by X-ray Fluorescence XRF.",
            "title": "Elemental Composition"
        },
        "OxideComposition": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/$defs/OxideCompositionItem"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The oxide composition of the sample determined by X-ray Fluorescence XRF.  Oxides are calculated, and as such may not be actually present as oxides within the sample.",
            "title": "Oxide Composition"
        },
        "XRFSourceTypeID": {
            "anyOf": [
                {
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-XRFSourceType:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The XRF source type refers to the primary radiation source. There are three main types: X-Ray tubes, Radioactive sources, and Synchrotrons.",
            "title": "XRF Source Type ID"
        },
        "XRFTubeTypeID": {
            "anyOf": [
                {
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-XRFTubeType:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "X-ray tubes used in X-ray fluorescence (XRF) analysis come in a variety of types and compositions to suit different applications, materials, and elemental ranges.",
            "title": "XRF Tube Type ID"
        },
        "IsEnergyDispersiveXRF": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Identifies the method of measurement.  If TRUE, the method is Energy-Dispersive X-ray fluorescence (EDXRF).  If FALSE, the method is Wavelength-Dispersive X-Ray fluoresence (WDXRF).",
            "title": "Is Energy Dispersive XRF"
        },
        "XRFInstrumentTypeID": {
            "anyOf": [
                {
                    "pattern": "^[\\w\\-\\.]+:reference-data\\-\\-XRFInstrumentType:[\\w\\-\\.\\:\\%]+:[0-9]*$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Identifies the instrument that was used during XRF acquisition. These will include handheld, bench, or synchrotron.",
            "title": "XRF Instrument Type ID"
        },
        "MassBalance": {
            "anyOf": [
                {
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The portion of the sample that is not accounted for by the measured elemental concentrations (e.g. carbon, oxygen, organic material, etc).",
            "title": "Mass Balance"
        },
        "GravimetricLossOnIgnition": {
            "anyOf": [
                {
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "The mass that the sample has lost, after heating up to temperatures where the loss of mass declines (~950-1050 degC).",
            "title": "Gravimetric Loss On Ignition"
        }
    },
    "required": [
        "SamplesAnalysisID",
        "SampleID",
        "Meta"
    ],
    "title": "XrfModel110",
    "type": "object"
}
